{
  // Подключаем общую конфигурацию TypeScript из родительского tsconfig.json
  "extends": "../tsconfig.json",
  // Опции компилятора TypeScript
  "compilerOptions": {
    // Не генерировать .js-файлы при сборке — использовать только для проверки типов
    "noEmit": true,
    // Указываем, что проект использует типы из Cypress
    "types": ["cypress"]
  },
  // Указываем, какие файлы следует включить в проверку типов
  "include": [
    // Добавляем типы Cypress из node_modules для корректной работы типизации
    "../node_modules/cypress",
    // Включаем все TypeScript-файлы в подкаталогах текущей папки
    "./**/*.ts",
    // Явно добавляем файл теста на Cypress в формате .tsx
    "e2e/constructor.cy.tsx"
  ]
}
