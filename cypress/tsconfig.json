{
  // Наследуем общие настройки TypeScript из расположенного выше файла tsconfig.json
  "extends": "../tsconfig.json",
  // Настройки компилятора TypeScript
  "compilerOptions": {
    // Отключаем генерацию выходных файлов .js — компиляция только для проверки типов
    "noEmit": true,
    // Указываем, что будут использоваться типы, предоставляемые Cypress
    "types": ["cypress"]
  },
  // Определяем файлы и папки, которые должны быть включены в компиляцию
  "include": [
    // Подключаем типы Cypress из node_modules (нужно для корректной типизации)
    "../node_modules/cypress",
    // Включаем все .ts-файлы во всех подпапках текущей директории
    "./**/*.ts",
    // Явно указываем конкретный файл с тестом на Cypress в формате .tsx
    "e2e/constructor.cy.tsx"
  ]
}
